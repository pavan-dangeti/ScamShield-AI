# Twilio Configuration
# Find your Auth Token in the Twilio Console: https://www.twilio.com/console
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Signature validation is ON by default and should stay on for any deployed
# webhook. Set to true only for local testing without ngrok.
SKIP_TWILIO_VALIDATION=false

# Comma-separated browser origins allowed to call the API. The dashboard is
# served by this same app, so add your deployed origin here.
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Analysis requests allowed per client per minute.
RATE_LIMIT_PER_MINUTE=30

# Model to serve: tfidf-lr (default, 10 MB) or xlmr-base-aug (1.1 GB, needs torch).
SCAMSHIELD_MODEL=tfidf-lr
