# Virtual Environment
.venv/

# Python cache
__pycache__/
*.py[cod]

# Environment Variables
.env

# SQLite database
*.db

# VS Code
.vscode/

# macOS
.DS_Store

# Serena agent tooling
.serena/

# Logs
*.log

# Build
dist/
build/

# Legacy pipeline artefacts (rebuilt by scripts/dataset_generator.py and src.train)
/models/
data/scam_dataset.csv

# Data pipeline: raw downloads and build artifacts are rebuilt by scripts.
# The frozen test set is force-added when it exists.
data/raw/
data/processed/

# Owner-supplied messages and in-progress labels stay local by default.
data/test_candidates/user_messages.jsonl
data/test_candidates/labels.jsonl

# Evaluation outputs the README quotes are committed (results/*.json and *.md) so
# tests/test_docs_honesty.py can check the README against them in CI. Per-message
# outputs contain message text and stay local.
results/*.jsonl
results/drift.json
docs/demo/*.mp4
.playwright-mcp/
